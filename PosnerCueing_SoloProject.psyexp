        <Param val="Welcome to the Attention Task!&amp;#10;Keep your eyes on the center cross at all times.&amp;#10;A circle will appear on either the LEFT or the RIGHT side of the screen.&amp;#10;Press the Z key if the circle appears on the LEFT.&amp;#10;Press the M key if the circle appears on the RIGHT.&amp;#10;Respond as quickly and accurately as possible.&amp;#10;&amp;#10;Press SPACE to begin.&amp;#10;" valType="str" updates="constant" name="text"/>
