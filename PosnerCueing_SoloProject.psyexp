        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="" valType="list" updates="constant" name="vertices"/>
      </PolygonComponent>
      <KeyboardComponent name="response_key" plugin="None">
        <Param val="'z','m'" valType="list" updates="set every repeat" name="allowedKeys"/>
